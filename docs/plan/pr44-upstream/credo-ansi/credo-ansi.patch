   end
 
   defp do_puts(value) do
-    Bunt.puts(value)
+    value |> format() |> IO.puts()
   end
 
   defp do_warn(value) do
-    Bunt.warn(value)
+    IO.puts(:stderr, format(value))
+  end
+
+  # Credo uses one extended color beyond IO.ANSI's named sequences.
+  # Preserve Bunt's orange (256-color index 214), including reset behavior.
+  defp format(nil), do: ""
+  defp format(value) when is_binary(value), do: value
+
+  defp format(value) do
+    values = List.flatten(value)
+
+    if IO.ANSI.enabled?() and Enum.any?(values, &is_atom/1) do
+      mapped =
+        Enum.map(values, fn
+          :orange -> IO.ANSI.color(214)
+          value -> value
+        end)
+
+      [IO.ANSI.format_fragment(mapped, true), IO.ANSI.reset()]
+    else
+      Enum.reject(values, &is_atom/1)
+    end
   end
 end
